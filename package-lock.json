// =====================================================================
// Window
// =====================================================================

function createWindow() {
  const win = new BrowserWindow({
    width: 1280,
    height: 820,
    minWidth: 800,
    minHeight: 500,
    frame: false,
    backgroundColor: '#0e0e12',
    title: 'Макс Браузер',
    icon: APP_ICON,
    webPreferences: {
      preload: path.join(APP_DIR, 'preload.js'),
      contextIsolation: true,
      nodeIntegration: false,
      sandbox: false,
      webviewTag: true,
      spellcheck: true
    }
  });

  if (!mainWindow) mainWindow = win;

  win.loadFile(path.join(RENDERER_DIR, 'index.html'));

  win.on('maximize',   () => win.webContents.send('window:state', { maximized: true,  fullscreen: win.isFullScreen() }));
  win.on('unmaximize', () => win.webContents.send('window:state', { maximized: false, fullscreen: win.isFullScreen() }));
  win.on('enter-full-screen', () => win.webContents.send('window:state', { maximized: win.isMaximized(), fullscreen: true }));
  win.on('leave-full-screen', () => win.webContents.send('window:state', { maximized: win.isMaximized(), fullscreen: false }));
  win.on('focus', () => win.webContents.send('window:focus', true));
  win.on('blur',  () => win.webContents.send('window:focus', false));
  win.on('closed', () => { if (mainWindow === win) mainWindow = null; });

  // Правый клик в самом UI окна: показываем минимальное меню только для редактируемых полей.
  // Для всего остального меню не показываем (правый клик не должен превращать окно в "сайт").
  win.webContents.on('context-menu', (_e, params) => {
    if (!params.isEditable) return;
    const m = Menu.buildFromTemplate([
      { role: 'undo',      label: 'Отменить' },
      { role: 'redo',      label: 'Повторить' },
      { type: 'separator' },
      { role: 'cut',       label: 'Вырезать' },
      { role: 'copy',      label: 'Копировать' },
      { role: 'paste',     label: 'Вставить' },
      { role: 'selectAll', label: 'Выделить всё' }
    ]);
    m.popup({ window: win });
  });

  return win;
}

function attachWebviewHandlers(contents) {
  setupSessionFiltering(contents.session);

  contents.setWindowOpenHandler(({ url: targetUrl }) => {
    if (mainWindow) {
      const cls = classifyUrl(targetUrl);
      let target = targetUrl;
      if      (cls === 'confirm') target = buildConfirmUrl(targetUrl);
      else if (cls === 'block')   target = buildBlockedUrl(targetUrl);
      mainWindow.webContents.send('open-tab', target);
    }
    return { action: 'deny' };
  });

  contents.on('will-navigate', (e, targetUrl) => {
    const maxUrl = resolveMaxUrl(targetUrl);
    if (maxUrl) {
      e.preventDefault();
      contents.loadURL(maxUrl);
      return;
    }
    const cls = classifyUrl(targetUrl);
    if (cls === 'confirm') { e.preventDefault(); contents.loadURL(buildConfirmUrl(targetUrl)); }
    else if (cls === 'block') { e.preventDefault(); contents.loadURL(buildBlockedUrl(targetUrl)); }
  });

  contents.on('context-menu', (_e, params) => {
    const menu = buildContextMenu(contents, params);
    menu.popup({ window: BrowserWindow.fromWebContents(contents) || mainWindow });
  });

  contents.on('did-navigate', (_e, navUrl, httpResponseCode, httpStatusText) => {
    if (storage) storage.addHistory({ url: navUrl, title: contents.getTitle() });
    // HTTP-ошибки 4xx/5xx главного фрейма: подменяем страницу на max://error,
    // чтобы пользователь видел понятный экран с кодом и причиной, а не пустоту.
    if (httpResponseCode && httpResponseCode >= 400 && navUrl && !isInternalUrl(navUrl)) {
      const target = buildErrorUrl({ originalUrl: navUrl, httpCode: httpResponseCode, desc: httpStatusText || '' });
      try { contents.loadURL(target); } catch {}
    }
  });
  contents.on('page-title-updated', (_e, title) => {
    const u = contents.getURL();
    if (storage) storage.addHistory({ url: u, title });
  });
  contents.on('did-fail-load', (_e, errorCode, errorDescription, validatedURL, isMainFrame) => {
    // -3 = ABORTED — пользователь отменил, не показываем ошибку.
    if (errorCode === -3) return;
    if (!isMainFrame) return;
    if (!validatedURL) return;
    if (isInternalUrl(validatedURL)) return;
    const target = buildErrorUrl({ originalUrl: validatedURL, netCode: errorCode, desc: errorDescription || '' });
    try { contents.loadURL(target); } catch {}
  });
}

// Внутренние URL не подменяем своей же страницей ошибки — они и так наши,
// и могут переоткрыться в бесконечный редирект.
function isInternalUrl(u) {
  if (!u) return false;
  if (u.startsWith('max:')) return true;
  if (u.startsWith('about:')) return true;
  if (u.startsWith('data:')) return true;
  if (u.startsWith('chrome-error:')) return true;
  // Любая наша max://-страница после resolve превращается в file:// внутри INTERNAL_DIR.
  try {
    const p = new url.URL(u);
    if (p.protocol === 'file:') {
      const decoded = decodeURIComponent(p.pathname).replace(/^\/+/, '');
      const norm = path.resolve(decoded);
      return norm.toLowerCase().startsWith(INTERNAL_DIR.toLowerCase());
    }
  } catch {}
  return false;
}

// =====================================================================
// IPC
// =====================================================================

function setupIpc() {
  ipcMain.handle('window:minimize',        () => mainWindow && mainWindow.minimize());
  ipcMain.handle('window:maximize-toggle', () => {
    if (!mainWindow) return false;
    if (mainWindow.isMaximized()) mainWindow.unmaximize(); else mainWindow.maximize();
    return mainWindow.isMaximized();
  });
  ipcMain.handle('window:close',         () => mainWindow && mainWindow.close());
  ipcMain.handle('window:is-maximized',  () => mainWindow ? mainWindow.isMaximized()  : false);
  ipcMain.handle('window:is-fullscreen', () => mainWindow ? mainWindow.isFullScreen() : false);
  ipcMain.handle('window:toggle-fullscreen', () => {
    if (!mainWindow) return false;
    mainWindow.setFullScreen(!mainWindow.isFullScreen());
    return mainWindow.isFullScreen();
  });

  ipcMain.handle('app:resolve-max-url',  (_e, u) => resolveMaxUrl(u));
  ipcMain.handle('app:check-url',        (_e, u) => shouldAllowUrl(u));
  ipcMain.handle('app:classify-url',     (_e, u) => classifyUrl(u));
  ipcMain.handle('app:blocked-page',     () => PAGES.blocked);
  ipcMain.handle('app:pages',            () => ({ ...PAGES }));

  // Whitelist
  ipcMain.handle('whitelist:get',  () => whitelist);
  ipcMain.handle('whitelist:save', (_e, next) => {
    const ok = saveWhitelist(next);
    if (ok && mainWindow) mainWindow.webContents.send('whitelist:updated', whitelist);
    return ok;
  });

  // Settings
  ipcMain.handle('settings:get',    () => storage.getSettings());
  ipcMain.handle('settings:update', (_e, patch) => {
    const safe = { ...(patch || {}) };
    // Защита: отключить фильтрацию через обычный settings:update нельзя.
    // Это делается только через app:disable-filter с правильным ключом.
    if ('whitelistEnabled' in safe && safe.whitelistEnabled === false) {
      delete safe.whitelistEnabled;
    }
    const s = storage.updateSettings(safe);
    if (mainWindow) mainWindow.webContents.send('settings:updated', s);
    return s;
  });

  ipcMain.handle('app:disable-filter', (_e, key) => {
    const provided = sha256Hex(String(key || '').trim());
    const ok = timingSafeEqualHex(provided, FILTER_OFF_KEY_SHA256);
    if (!ok) return { ok: false };
    const s = storage.updateSettings({ whitelistEnabled: false });
    if (mainWindow) mainWindow.webContents.send('settings:updated', s);
    return { ok: true };
  });
  ipcMain.handle('app:enable-filter', () => {
    const s = storage.updateSettings({ whitelistEnabled: true });
    if (mainWindow) mainWindow.webContents.send('settings:updated', s);
    return { ok: true };
  });

  // History
  ipcMain.handle('history:get',     (_e, limit) => storage.getHistory(limit));
  ipcMain.handle('history:remove',  (_e, ts) => { storage.removeHistory(ts); return storage.getHistory(); });
  ipcMain.handle('history:clear',   () => { storage.clearHistory(); return []; });

  // Bookmarks
  ipcMain.handle('bookmarks:get',    () => storage.getBookmarks());
  ipcMain.handle('bookmarks:add',    (_e, b) => {
    const item = storage.addBookmark(b);
    if (mainWindow) mainWindow.webContents.send('bookmarks:updated', storage.getBookmarks());
    return item;
  });
  ipcMain.handle('bookmarks:remove', (_e, id) => {
    storage.removeBookmark(id);
    if (mainWindow) mainWindow.webContents.send('bookmarks:updated', storage.getBookmarks());
    return storage.getBookmarks();
  });
  ipcMain.handle('bookmarks:is',     (_e, u) => storage.isBookmarked(u));

  // Downloads
  ipcMain.handle('downloads:get',          () => storage.getDownloads());
  ipcMain.handle('downloads:clear',        () => { storage.clearDownloads(); broadcastDownloads(); return []; });
  ipcMain.handle('downloads:open-file',    (_e, p) => shell.openPath(p));
  ipcMain.handle('downloads:show-in-folder', (_e, p) => { shell.showItemInFolder(p); });

  // Clear browsing data
  ipcMain.handle('app:clear-data', async (_e, opts = {}) => {
    const ses = session.defaultSession;
    const partition = session.fromPartition('persist:max');
    const targets = [];
    if (opts.cache)   targets.push('cache');
    if (opts.cookies) targets.push('cookies');
    const storages = [];
    if (opts.cookies) storages.push('cookies');
    if (opts.local)   storages.push('localstorage', 'indexdb', 'shadercache', 'serviceworkers', 'cachestorage');

    for (const s of [ses, partition]) {
      if (targets.includes('cache')) await s.clearCache();
      if (storages.length) await s.clearStorageData({ storages });
    }
    if (opts.history) storage.clearHistory();
    return true;
  });

  // External shell
  ipcMain.handle('shell:open-external', (_e, u) => shell.openExternal(u));

  // From renderer: navigate active webview to an URL (used by internal pages)
  ipcMain.on('nav:open', (_e, target, opts = {}) => {
    if (mainWindow) mainWindow.webContents.send('open-tab', target, opts);
  });
}

// =====================================================================
// App lifecycle
// =====================================================================

protocol.registerSchemesAsPrivileged([
  { scheme: 'max', privileges: { standard: true, secure: true, supportFetchAPI: true } }
]);

// User-Agent: Chromium-совместимый, чтобы сайты отдавали нормальный фронтенд,
// но с фирменным токеном MaxBrowser/<версия>, по которому браузер можно
// отличить в логах. Из родного UA вырезаем упоминание Electron.
function buildMaxUserAgent() {
  const base = (app.userAgentFallback || '')
    .replace(/\sElectron\/[\d.]+/i, '')
    .replace(/\smax-browser\/[\d.]+/i, '');
  const version = (app.getVersion && app.getVersion()) || '1.0.0';
  return (base + ' MaxBrowser/' + version).trim();
}

app.whenReady().then(() => {
  // Без AppUserModelID Windows показывает иконку Electron в панели задач
  // и группирует окна как «electron.exe». Привязываем к нашему ID.
  if (process.platform === 'win32') {
    try { app.setAppUserModelId('ru.maxbrowser.app'); } catch {}
  }

  storage = new Storage(app.getPath('userData'));
  loadWhitelist();
  watchWhitelist();

  const MAX_UA = buildMaxUserAgent();
  app.userAgentFallback = MAX_UA;
  try { session.defaultSession.setUserAgent(MAX_UA); } catch {}

  setupSessionFiltering(session.defaultSession);
  const partition = session.fromPartition('persist:max');
  try { partition.setUserAgent(MAX_UA); } catch {}
  setupSessionFiltering(partition);
  const internalPreload = path.join(APP_DIR, 'internal-preload.js');
  try {
    if (typeof partition.registerPreloadScript === 'function') {
      partition.registerPreloadScript({ filePath: internalPreload, type: 'frame' });
    } else {
      partition.setPreloads([internalPreload]);
    }
  } catch (err) {
    console.warn('[preload] register failed:', err.message);
  }
  setupIpc();
  buildAppMenu();

  app.on('web-contents-created', (_event, contents) => {
    if (contents.getType() === 'webview') {
      attachWebviewHandlers(contents);
    }
  });

  createWindow();

  app.on('activate', () => {
    if (BrowserWindow.getAllWindows().length === 0) createWindow();
  });
});

app.on('window-all-closed', () => {
  if (process.platform !== 'darwin') app.quit();
});
