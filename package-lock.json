'use strict';

const { app, BrowserWindow, ipcMain, session, shell, Menu, MenuItem, clipboard, dialog, protocol, webContents } = require('electron');
const path = require('node:path');
const fs = require('node:fs');
const net = require('node:net');
const url = require('node:url');
const crypto = require('node:crypto');

// SHA-256 от ключа сертификации, разрешающего отключение фильтрации.
// Сам ключ в исходниках не хранится: сравниваем только хэши, поэтому
// восстановить оригинал из исходного кода невозможно.
const FILTER_OFF_KEY_SHA256 = '4dd665bbdbc01522dbe80b7124baca184c09cab74c00da6afea2fbb323d326aa';

function sha256Hex(s) {
  return crypto.createHash('sha256').update(String(s || ''), 'utf8').digest('hex');
}
function timingSafeEqualHex(aHex, bHex) {
  try {
    const a = Buffer.from(String(aHex), 'hex');
    const b = Buffer.from(String(bHex), 'hex');
    if (a.length !== b.length) return false;
    return crypto.timingSafeEqual(a, b);
  } catch { return false; }
}

const Storage = require('./storage');

const APP_DIR = __dirname;
const WHITELIST_PATH = path.join(APP_DIR, 'whitelist.json');
const ASSETS_DIR = path.join(APP_DIR, 'assets');
const APP_ICON = process.platform === 'win32'
  ? path.join(ASSETS_DIR, 'icon.ico')
  : path.join(ASSETS_DIR, 'icon.png');

const RENDERER_DIR = path.join(APP_DIR, 'renderer');
const INTERNAL_DIR = path.join(RENDERER_DIR, 'internal');

// Корректный file:// URL (file:///D:/... с тремя слешами и нормализованным регистром).
// Без этого Electron нормализует наш URL и сравнения через === ломаются.
function fileUrl(p) { return url.pathToFileURL(p).href; }

const PAGES = {
  start:     fileUrl(path.join(INTERNAL_DIR, 'start.html')),
  blocked:   fileUrl(path.join(INTERNAL_DIR, 'blocked.html')),
  confirm:   fileUrl(path.join(INTERNAL_DIR, 'confirm.html')),
  error:     fileUrl(path.join(INTERNAL_DIR, 'error.html')),
  settings:  fileUrl(path.join(INTERNAL_DIR, 'settings.html')),
  history:   fileUrl(path.join(INTERNAL_DIR, 'history.html')),
  bookmarks: fileUrl(path.join(INTERNAL_DIR, 'bookmarks.html')),
  downloads: fileUrl(path.join(INTERNAL_DIR, 'downloads.html')),
  about:     fileUrl(path.join(INTERNAL_DIR, 'about.html'))
};

let whitelist = { domains: [], ips: [] };
let storage;
let mainWindow = null;

// =====================================================================
// Whitelist
// =====================================================================

function loadWhitelist() {
  try {
    const raw = fs.readFileSync(WHITELIST_PATH, 'utf-8');
    const parsed = JSON.parse(raw);
    whitelist = {
      domains: Array.isArray(parsed.domains) ? parsed.domains.map(d => String(d).toLowerCase().trim()).filter(Boolean) : [],
      ips:     Array.isArray(parsed.ips)     ? parsed.ips.map(i => String(i).trim()).filter(Boolean)             : []
    };
    console.log('[whitelist] загружен:', whitelist.domains.length, 'доменов,', whitelist.ips.length, 'IP');
    if (mainWindow) mainWindow.webContents.send('whitelist:updated', whitelist);
  } catch (err) {
    console.error('[whitelist] ошибка чтения:', err.message);
    whitelist = { domains: [], ips: [] };
  }
}

function saveWhitelist(next) {
  try {
    const data = {
      domains: Array.isArray(next.domains) ? next.domains : whitelist.domains,
      ips:     Array.isArray(next.ips)     ? next.ips     : whitelist.ips
    };
    fs.writeFileSync(WHITELIST_PATH, JSON.stringify(data, null, 2), 'utf-8');
    whitelist = data;
    return true;
  } catch (err) {
    console.error('[whitelist] save failed:', err.message);
    return false;
  }
}

function watchWhitelist() {
  try {
    fs.watch(WHITELIST_PATH, { persistent: false }, () => setTimeout(loadWhitelist, 100));
  } catch (err) {
    console.warn('[whitelist] watch failed:', err.message);
  }
}

function hostMatchesDomain(host, domain) {
  host = host.toLowerCase();
  domain = domain.toLowerCase();
  if (domain.startsWith('*.')) {
    const base = domain.slice(2);
    return host === base || host.endsWith('.' + base);
  }
  return host === domain || host.endsWith('.' + domain);
}

// Разрешённые TLD: .ru и .рф (в punycode .xn--p1ai)
const RU_TLDS = ['.ru', '.рф', '.xn--p1ai', '.su'];

function isRussianHost(host) {
  if (!host) return false;
  const h = host.toLowerCase();
  return RU_TLDS.some(t => h === t.slice(1) || h.endsWith(t));
}

function isHostAllowed(host) {
  if (!host) return false;
  if (net.isIP(host)) return whitelist.ips.includes(host) || host === '127.0.0.1' || host === '::1';
  // 1) Российские TLD — всегда ок
  if (isRussianHost(host)) return true;
  // 2) Дополнительный whitelist (исключения)
  return whitelist.domains.some(d => hostMatchesDomain(host, d));
}

function isInternalScheme(u) {
  try {
    const p = new url.URL(u);
    return ['file:', 'about:', 'chrome:', 'devtools:', 'data:', 'blob:', 'chrome-extension:', 'max:'].includes(p.protocol);
  } catch {
    return true;
  }
}

// Уровни допуска к URL
//  'allow'   — пускаем
//  'confirm' — нужно подтверждение пользователя (зарубежный хост)
//  'block'   — финально блокируем (пользователь подтвердил доступ к зарубежу)
function classifyUrl(u) {
  if (!u) return 'allow';
  if (!storage || storage.settings.whitelistEnabled === false) return 'allow';
  if (isInternalScheme(u)) return 'allow';
  try {
    const parsed = new url.URL(u);
    const host = parsed.hostname;
    if (isHostAllowed(host)) return 'allow';
    return 'confirm';
  } catch { return 'block'; }
}

function shouldAllowUrl(u) {
  return classifyUrl(u) === 'allow';
}

function buildBlockedUrl(originalUrl) {
  return PAGES.blocked + '?url=' + encodeURIComponent(originalUrl || '');
}
function buildConfirmUrl(originalUrl) {
  return PAGES.confirm + '?url=' + encodeURIComponent(originalUrl || '');
}

// =====================================================================
// max:// scheme — превращаем max://settings → file://.../internal/settings.html
// =====================================================================

function resolveMaxUrl(u) {
  try {
    const parsed = new url.URL(u);
    if (parsed.protocol !== 'max:') return null;
    const name = (parsed.hostname || parsed.pathname.replace(/^\/+/, '')).toLowerCase();
    const target = PAGES[name];
    if (!target) return null;
    // Пробрасываем query/hash, чтобы max://error?code=-105&url=... работал.
    const search = parsed.search || '';
    const hash = parsed.hash || '';
    return target + search + hash;
  } catch { return null; }
}

function buildErrorUrl({ originalUrl = '', netCode = 0, httpCode = 0, desc = '' } = {}) {
  const qs = new URLSearchParams();
  if (originalUrl) qs.set('url', originalUrl);
  if (netCode)     qs.set('code', String(netCode));
  if (httpCode)    qs.set('http', String(httpCode));
  if (desc)        qs.set('desc', desc);
  const sep = PAGES.error.includes('?') ? '&' : '?';
  return PAGES.error + sep + qs.toString();
}

// =====================================================================
// Network filtering
// =====================================================================

function setupSessionFiltering(ses) {
  if (ses.__maxFilterInstalled) return;
  ses.__maxFilterInstalled = true;

  ses.webRequest.onBeforeRequest({ urls: ['<all_urls>'] }, (details, callback) => {
    const u = details.url;
    // Фильтруем только переход на страницу (главный фрейм). Все подзапросы
    // (CSS, JS, шрифты, картинки, XHR, iframe, медиа) — пропускаем, иначе
    // у разрешённых сайтов отваливаются стили и скрипты, которые лежат на
    // CDN с зарубежными доменами (yastatic.net, gstatic.com, cloudflare и т.п.).
    if (details.resourceType !== 'mainFrame') {
      return callback({ cancel: false });
    }
    const cls = classifyUrl(u);
    if (cls === 'allow') return callback({ cancel: false });

    // Chromium запрещает редирект https→file через webRequest (ERR_UNSAFE_REDIRECT).
    // Поэтому отменяем загрузку и сами навигируем нужный webContents на нашу страницу.
    const target = cls === 'confirm' ? buildConfirmUrl(u) : buildBlockedUrl(u);
    callback({ cancel: true });
    try {
      const wc = (typeof details.webContentsId === 'number')
        ? webContents.fromId(details.webContentsId)
        : null;
      if (wc && !wc.isDestroyed()) {
        setImmediate(() => { try { wc.loadURL(target); } catch (e) { console.warn('loadURL failed', e.message); } });
      }
    } catch (err) {
      console.warn('redirect via loadURL failed:', err.message);
    }
  });

  // Скачивания
  ses.on('will-download', (event, item, webContents) => {
    const id = 'd' + Date.now() + Math.random().toString(36).slice(2, 6);
    const filename = item.getFilename();
    const sourceUrl = item.getURL();
    const totalBytes = item.getTotalBytes();

    const record = {
      id,
      filename,
      url: sourceUrl,
      savePath: '',
      totalBytes,
      receivedBytes: 0,
      state: 'progressing',
      startedAt: Date.now(),
      endedAt: null
    };
    storage.upsertDownload(record);
    broadcastDownloads();

    item.on('updated', (_e, state) => {
      record.receivedBytes = item.getReceivedBytes();
      record.totalBytes    = item.getTotalBytes();
      record.savePath      = item.getSavePath();
      record.state         = state;
      storage.upsertDownload(record);
      broadcastDownloads();
    });
    item.once('done', (_e, state) => {
      record.state    = state;
      record.endedAt  = Date.now();
      record.savePath = item.getSavePath();
      record.receivedBytes = item.getReceivedBytes();
      storage.upsertDownload(record);
      broadcastDownloads();
    });
  });
}

function broadcastDownloads() {
  if (mainWindow) mainWindow.webContents.send('downloads:updated', storage.getDownloads());
}

// =====================================================================
// Window / context menu
// =====================================================================

function buildContextMenu(contents, params) {
  const items = [];
  const editable  = params.isEditable;
  const hasText   = params.selectionText && params.selectionText.trim().length > 0;
  const linkUrl   = params.linkURL;
  const imageUrl  = params.srcURL;
  const mediaType = params.mediaType;

  const dispatchOpen = (target) => {
    const cls = classifyUrl(target);
    let final = target;
    if      (cls === 'confirm') final = buildConfirmUrl(target);
    else if (cls === 'block')   final = buildBlockedUrl(target);
    mainWindow.webContents.send('open-tab', final);
  };

  if (linkUrl) {
    items.push(new MenuItem({ label: 'Открыть ссылку в новой вкладке', click: () => dispatchOpen(linkUrl) }));
    items.push(new MenuItem({ label: 'Копировать адрес ссылки', click: () => clipboard.writeText(linkUrl) }));
    items.push(new MenuItem({ type: 'separator' }));
  }

  if (mediaType === 'image' && imageUrl) {
    items.push(new MenuItem({ label: 'Открыть изображение в новой вкладке', click: () => dispatchOpen(imageUrl) }));
    items.push(new MenuItem({ label: 'Копировать адрес изображения', click: () => clipboard.writeText(imageUrl) }));
    items.push(new MenuItem({ type: 'separator' }));
  }

  if (editable) {
    items.push(new MenuItem({ role: 'undo', label: 'Отменить' }));
    items.push(new MenuItem({ role: 'redo', label: 'Повторить' }));
    items.push(new MenuItem({ type: 'separator' }));
    items.push(new MenuItem({ role: 'cut',   label: 'Вырезать' }));
    items.push(new MenuItem({ role: 'copy',  label: 'Копировать' }));
    items.push(new MenuItem({ role: 'paste', label: 'Вставить' }));
    items.push(new MenuItem({ role: 'selectAll', label: 'Выделить всё' }));
  } else {
    if (hasText) {
      items.push(new MenuItem({ role: 'copy', label: 'Копировать' }));
      items.push(new MenuItem({ label: 'Найти в Яндексе: «' + params.selectionText.slice(0, 30) + '»', click: () => {
        dispatchOpen('https://yandex.ru/search/?text=' + encodeURIComponent(params.selectionText));
      }}));
      items.push(new MenuItem({ type: 'separator' }));
    }
    items.push(new MenuItem({ label: 'Назад',     click: () => contents.canGoBack() && contents.goBack(),    enabled: contents.canGoBack() }));
    items.push(new MenuItem({ label: 'Вперёд',    click: () => contents.canGoForward() && contents.goForward(), enabled: contents.canGoForward() }));
    items.push(new MenuItem({ label: 'Обновить',  click: () => contents.reload() }));
    items.push(new MenuItem({ type: 'separator' }));
    items.push(new MenuItem({ label: 'Сохранить страницу как...', click: () => {
      contents.downloadURL(contents.getURL());
    }}));
    items.push(new MenuItem({ label: 'Печать...', click: () => contents.print({ silent: false, printBackground: true }) }));
  }

  items.push(new MenuItem({ type: 'separator' }));
  items.push(new MenuItem({ label: 'Просмотреть код', accelerator: 'F12', click: () => mainWindow && mainWindow.webContents.send('cmd:devtools') }));
  items.push(new MenuItem({ label: 'Исследовать элемент', click: () => mainWindow && mainWindow.webContents.send('cmd:devtools') }));

  return Menu.buildFromTemplate(items);
}

